# ==== Configuration du bot ====
# Token du bot (Discord Developer Portal > ton appli > Bot > Reset Token)
DISCORD_TOKEN=colle_ton_token_ici

# ID de l'application (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=id_de_ton_application

# ID de ton serveur de test (clic droit sur le serveur > Copier l'identifiant)
# Utilisé pour déployer les commandes instantanément pendant le dev.
# Laisse vide pour un déploiement global (peut prendre jusqu'à 1h).
GUILD_ID=id_de_ton_serveur

# Couleur des embeds (hex sans le #)
EMBED_COLOR=5865F2

# ==== Spotify (optionnel) ====
# Nécessaire uniquement pour que /play et /playlist acceptent les liens Spotify
# (piste/album/playlist). Sans ces identifiants, tout le reste du bot fonctionne
# normalement — seuls les liens Spotify échoueront avec un message clair.
# Crée une appli gratuite sur https://developer.spotify.com/dashboard
# (Client ID + Client Secret, aucune autre config nécessaire).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

